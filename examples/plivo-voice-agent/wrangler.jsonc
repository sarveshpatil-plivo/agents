{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "plivo-voice-agent",
  "compatibility_date": "2026-01-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/agents/*", "/answer", "/plivo"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyVoiceAgent",
        "name": "MyVoiceAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["MyVoiceAgent"],
      "tag": "v1"
    }
  ]
}
