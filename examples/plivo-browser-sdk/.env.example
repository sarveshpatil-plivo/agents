# Plivo credentials — copy to .env and fill in your values.
# Get these from console.plivo.com → Account → Overview.
PLIVO_AUTH_ID=your_auth_id_here
PLIVO_AUTH_TOKEN=your_auth_token_here

# E.164 format, e.g. +12025551234
PLIVO_PHONE_NUMBER=+1xxxxxxxxxx

# Username of a Plivo WebRTC endpoint (console.plivo.com → Voice → Endpoints).
# The browser client logs in as this endpoint to place calls to your agent.
PLIVO_ENDPOINT_USERNAME=your_endpoint_username
